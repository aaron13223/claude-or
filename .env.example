# Copy to .env and fill in. Never commit .env.
# Get a key at https://openrouter.ai/keys
# (Not needed for the chatgpt aliases: they use your Codex login, see `codex login`.)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: DeepSeek's own API, for `./claude-or deepseek-api` (or `deepseek:<model>`).
# Get a key at https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional: model for Enter at the menu and for `./claude-or -p "..."`.
# CLAUDE_OR_DEFAULT_MODEL=gpt
