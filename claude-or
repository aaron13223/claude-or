# ---- usage status line ----
# Shows usage at the bottom of Claude Code; see the --statusline section at the
# top. --settings outranks the user's settings files, so skip it when they
# already set a statusLine (user, project, or local settings) or pass their own
# --settings. CLAUDE_OR_STATUSLINE=0 turns it off.
STATUSLINE=1
case "${CLAUDE_OR_STATUSLINE:-}" in 0|false|off) STATUSLINE=0 ;; esac
for a in ${ARGS[@]+"${ARGS[@]}"}; do
  case "$a" in --settings|--settings=*) STATUSLINE=0 ;; esac
done
SL_SETTINGS=""
if (( STATUSLINE )) && [[ -z "$(user_statusline_file)" ]]; then
  SL_SETTINGS="$(python3 -I -c '
import json, shlex, sys
cmd = "%s --statusline %s" % (shlex.quote(sys.argv[1]), sys.argv[2])
print(json.dumps({"statusLine": {"type": "command", "command": cmd, "refreshInterval": 30}}))' \
    "$SELF" "$BACKEND" 2>/dev/null || true)"
fi

# ---- start the local proxy ----
# ChatGPT mode always needs it (translation). OpenRouter mode uses it only to show
# what this session cost: Claude Code drops OpenRouter's per-response `cost` before
# writing transcripts, so the proxy forwards requests byte-for-byte and adds each
# response's cost to the session's total (keyed by the session id Claude Code puts
# in metadata.user_id). It also covers side requests (classifier, titles,
# suggestions, subagents), which never reach the transcript. Without the status
# line there is nothing to show, so OpenRouter then goes direct; if the proxy
# fails to start it also goes direct, without the session cost.
start_proxy() {
  PROXY_SECRET="$(head -c 32 /dev/urandom | md5sum | cut -d' ' -f1)"
  exec {PROXY_FD}< <(CLAUDE_OR_PROXY_SECRET="$PROXY_SECRET" CLAUDE_OR_PROXY_MODE="$BACKEND" \
                     CLAUDE_OR_UPSTREAM_KEY="${OPENROUTER_API_KEY:-}" \
                     exec python3 -I -c "$(local_proxy_py)" "$$" \
                       </dev/null 2>>"${CLAUDE_OR_PROXY_LOG:-/dev/null}")
  PROXY_PORT=""
  read -r -t 10 -u "$PROXY_FD" PROXY_PORT || true
  exec {PROXY_FD}<&-
  [[ "$PROXY_PORT" =~ ^[0-9]+$ ]]
}
if [[ "$BACKEND" == chatgpt ]]; then
  CODEX_AUTH="${CODEX_HOME:-$HOME/.codex}/auth.json"
  if ! python3 -I -c '
import json, sys
tok = json.load(open(sys.argv[1])).get("tokens") or {}
sys.exit(0 if tok.get("refresh_token") else 1)' "$CODEX_AUTH" 2>/dev/null; then
    echo "No ChatGPT login in $CODEX_AUTH. Run: codex login" >&2; exit 1
  fi
  if ! start_proxy; then
    echo "ChatGPT proxy failed to start (set CLAUDE_OR_PROXY_LOG=<file> to see why)" >&2; exit 1
  fi
  export ANTHROPIC_BASE_URL="http://127.0.0.1:$PROXY_PORT"
  export ANTHROPIC_AUTH_TOKEN="$PROXY_SECRET"
elif [[ -n "$SL_SETTINGS" ]]; then
  if start_proxy; then
    export ANTHROPIC_BASE_URL="http://127.0.0.1:$PROXY_PORT"
    export ANTHROPIC_AUTH_TOKEN="$PROXY_SECRET"
  else
    echo "→ note: usage proxy failed to start; going direct to OpenRouter (no session cost)" >&2
  fi
fi
[[ -n "$SL_SETTINGS" ]] && set -- --settings "$SL_SETTINGS" "$@"

if [[ -z "${CLAUDE_OR_NO_VERSION_CHECK:-}" ]]; then
