  fi
fi

VIA="OpenRouter"; [[ "$BACKEND" == chatgpt ]] && VIA="ChatGPT subscription"
echo "→ Claude Code via $VIA, model: $MODEL_ID${PROVIDER:+ (provider: $PROVIDER, no fallback)}${effort:+ (reasoning effort: $effort)}${CTX:+ (context: $CTX)}${OUT:+ (max output: $OUT)}${PROMPT_TEXT:+ (custom system prompt)}" >&2
if (( AUTO_MODE )); then
