#!/usr/bin/env bash
# Launch Claude Code against OpenRouter with any model (GPT, Grok, Gemini, ...),
# or against your ChatGPT subscription.
#
# Usage:
#   ./claude-or                     # interactive model picker
#   ./claude-or gpt                 # use an alias
#   ./claude-or x-ai/grok-4.7 -p "hi" # any OpenRouter model ID; extra args go to claude
#   ./claude-or deepseek@stepfun    # force a specific OpenRouter provider for one run
#   ./claude-or deepseek            # deepseek runs at reasoning effort "max" (see EFFORT below)
#   ./claude-or deepseek --no-auto  # bypass every permission prompt (the old default)
#   ./claude-or chatgpt             # ChatGPT subscription (gpt-6-sol), no OpenRouter billing
#   ./claude-or --list              # show aliases
#   ./claude-or --version           # print wrapper version
#
# Reads OPENROUTER_API_KEY from .env next to this script (OpenRouter models only).
#
# ChatGPT subscription: `./claude-or chatgpt` (or any `chatgpt:<slug>`, e.g.
# chatgpt:gpt-6-luna) bills your ChatGPT plan instead of OpenRouter. It reuses
# the Codex CLI login in ~/.codex/auth.json (or $CODEX_HOME), so run `codex
# login` once; no OpenRouter key is needed. A local proxy, started per run and
# stopped with Claude Code, translates Anthropic Messages to the Codex Responses
# backend. CLAUDE_OR_PROXY_LOG=<file> logs its requests. See CHATGPT SUBSCRIPTION
# below.
#
# Auto mode is the default: it runs Claude Code's own safety classifier, pointed
# at anthropic/claude-haiku-5.5. Override with CLAUDE_OR_CLASSIFIER_MODEL (and
# CLAUDE_OR_CLASSIFIER_PROVIDER if you want the classifier on a specific
# provider). In ChatGPT mode the classifier is gpt-6-luna on the same
# subscription (CLAUDE_OR_CLASSIFIER_MODEL takes a ChatGPT slug there). See AUTO
# MODE below for why the stock server-side check cannot work through OpenRouter.
#
# Usage status line: credits left (OpenRouter) or 5h/weekly plan limits
# (ChatGPT) stay visible at the bottom of Claude Code, refreshed every 30s and
# cached across runs. Skipped when you set your own statusLine or --settings;
# CLAUDE_OR_STATUSLINE=0 turns it off. See USAGE STATUS LINE below.
#
# System prompt: system-prompt.md next to this script is appended to Claude
# Code's own system prompt on every run (edit it to set a house style). Override
# with CLAUDE_OR_SYSTEM_PROMPT (literal text) or CLAUDE_OR_SYSTEM_PROMPT_FILE (a
# path); CLAUDE_OR_SYSTEM_PROMPT=0 turns the append off. See APPENDED SYSTEM
# PROMPT below.
#
# Prompt suggestions (the greyed next-prompt text) are forced on with
# CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=1, because their GrowthBook gate never
# loads under a third-party endpoint. Set that variable to 0 to turn them off.
# See PROMPT SUGGESTIONS below for the per-model caveat.
#
# Skill parity: custom models get Claude Code's bundled + installed-plugin skills,
# but not the account skills Claude Code only syncs under a first-party model
# (pdf, docx, xlsx, pptx, skill-creator, deep-research). This script re-exposes
# those via a generated local plugin, .skills-plugin/ next to itself.

set -euo pipefail

# ---- wrapper version (SemVer; must match the top entry in changelog.txt) ----
CLAUDE_OR_VERSION="1.2.0"
if [[ "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then
  echo "claude-or $CLAUDE_OR_VERSION"; exit 0
fi

# ---- usage status line (internal: `claude-or --statusline <backend>`) ----
# Third-party endpoints get no /usage or plan-limit display in Claude Code, so
# each run injects a statusLine (via --settings) that calls back into this
# script. It inherits Claude Code's env, so it reuses ANTHROPIC_AUTH_TOKEN: the
# OpenRouter key, or in ChatGPT mode the proxy's token (the proxy fetches Codex's
# wham/usage with its own refresh-safe login). Results are cached per backend in
# ${XDG_CACHE_HOME:-~/.cache}/claude-or/ for 60s and kept across runs, so a new
# session starts with the last known numbers and Claude Code's 30s refresh costs
# at most one request a minute. A failed fetch shows the cached line, marked
# "(stale)" once it is over 10 minutes old.
usage_statusline_py() {
  cat <<'PY'
import json, os, sys, time, urllib.request

backend = sys.argv[1] if len(sys.argv) > 1 else "openrouter"
TTL, STALE = 60, 600
cache_dir = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "claude-or")
cache = os.path.join(cache_dir, "usage-%s.json" % backend)
token = os.environ.get("ANTHROPIC_AUTH_TOKEN", "")
try:
    session = json.load(sys.stdin)
except Exception:
    session = {}


def get(url):
    req = urllib.request.Request(url, headers={"Authorization": "Bearer " + token})
    with urllib.request.urlopen(req, timeout=3) as r:
        return json.load(r)


def fetch():
    if backend == "chatgpt":
        return get(os.environ.get("ANTHROPIC_BASE_URL", "").rstrip("/") + "/claude-or/usage")
    key = get("https://openrouter.ai/api/v1/key")["data"]
    credits = get("https://openrouter.ai/api/v1/credits")["data"]
    return {"key": {k: key.get(k) for k in ("limit", "limit_remaining", "limit_reset")},
            "credits": credits}


def dur(sec):
    sec = max(0, int(sec or 0))
    d, h, m = sec // 86400, sec % 86400 // 3600, sec % 3600 // 60
    return "%dd%dh" % (d, h) if d else "%dh%02dm" % (h, m) if h else "%dm" % m


def render(data, age):
    parts = []
    if backend == "chatgpt":
        rl = data.get("rate_limit") or {}
        parts.append("ChatGPT " + (data.get("plan_type") or "").title())
        if rl.get("limit_reached"):
            parts.append("LIMIT REACHED")
        for name, w in (("primary", rl.get("primary_window")), ("secondary", rl.get("secondary_window"))):
            if not w:
                continue
            secs = w.get("limit_window_seconds") or 0
            label = "week" if secs >= 6 * 86400 else ("%dh" % (secs // 3600) if secs >= 3600 else name)
            left = (w.get("reset_after_seconds") or 0) - age   # count down from the cached value
            parts.append("%s %d%% used, resets %s" % (label, w.get("used_percent") or 0, dur(left)))
        cr = data.get("credits") or {}
        if cr.get("unlimited"):
            parts.append("credits unlimited")
        elif cr.get("has_credits"):
            parts.append("credits %s" % cr.get("balance"))
    else:
        c, k = data.get("credits") or {}, data.get("key") or {}
        left = (c.get("total_credits") or 0) - (c.get("total_usage") or 0)
        parts.append("OpenRouter $%.2f credits left" % left)
        if k.get("limit") is not None and k.get("limit_remaining") is not None:
            parts.append("key $%.2f/$%g left%s" % (k["limit_remaining"], k["limit"],
                         " (%s)" % k["limit_reset"] if k.get("limit_reset") else ""))
    line = " · ".join(parts)
    model = (session.get("model") or {}).get("display_name")
    if model:
        line = model + " · " + line
    return line + (" (stale)" if age > STALE else "")


cached = None
try:
    with open(cache) as f:
        cached = json.load(f)
except Exception:
    pass
now = time.time()
if not cached or now - cached.get("t", 0) > TTL:
    try:
        cached = {"t": now, "data": fetch()}
        os.makedirs(cache_dir, exist_ok=True)
        tmp = "%s.%d.tmp" % (cache, os.getpid())
        with open(tmp, "w") as f:
            json.dump(cached, f)
        os.replace(tmp, cache)
    except Exception:
        pass
if cached:
    print(render(cached["data"], now - cached.get("t", now)))
else:
    print("usage unavailable")
PY
}
if [[ "${1:-}" == "--statusline" ]]; then
  exec python3 -I -c "$(usage_statusline_py)" "${2:-openrouter}"
fi

# ---- tested Claude Code version ----
# Last Claude Code version this script was checked against. On launch, a newer
# installed version prints a one-line note (silence: CLAUDE_OR_NO_VERSION_CHECK=1).
# When it fires, read the changelog entries since this version for anything that
# touches the internals below, retest, then bump TESTED_CC_VERSION:
#   - env vars: ANTHROPIC_BASE_URL/AUTH_TOKEN/MODEL/SMALL_FAST_MODEL/DEFAULT_*_MODEL,
#     CLAUDE_CODE_SUBAGENT_MODEL, CLAUDE_CODE_EXTRA_BODY,
#     CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC (and the per-piece DISABLE_* vars),
#     CLAUDE_CODE_DISABLE_FEATURE_FLAGS, ENABLE_CLAUDEAI_MCP_SERVERS, CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION
#     (and its 10k-uncached-token ceiling), CLAUDE_CODE_MAX_CONTEXT_TOKENS,
#     CLAUDE_CODE_MAX_OUTPUT_TOKENS (no auto-retry at a max_tokens error since 2.1.329)
#   - auto mode: CLAUDE_CODE_AUTO_MODE_SERVER, CLAUDE_CODE_AUTO_MODE_MODEL,
#     server-side `safeguards` verdicts, --permission-mode auto
#   - skill sync: ~/.claude/skills/synced/<bucket>/manifest.json layout, the
#     firstParty gate, ~/.claude/plugins/synced, --plugin-dir, plugin.json schema
#   - session title gating on nonessential traffic
#   - flags: --append-system-prompt, --dangerously-skip-permissions, --settings
#   - status line: statusLine {type, command, refreshInterval} schema, stdin JSON
#     (model.display_name), env inherited by the command
#   - ChatGPT proxy: the Messages request shape it translates (role "system"
#     messages, thinking signatures echoed back, output_config.effort, tool_choice)
TESTED_CC_VERSION="2.1.329"

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# ---- model aliases (edit freely; IDs from https://openrouter.ai/models) ----
# Pinned models get a `@provider` suffix. Suffix syntax is a wrapper feature: it's
# stripped and sent as OpenRouter's provider.only (allow_fallbacks off) via
# CLAUDE_CODE_EXTRA_BODY, so a request fails loudly instead of silently rerouting.
declare -A MODELS=(
  [gpt]="openai/gpt-6.2-sol"
  [gpt-mini]="openai/gpt-6-luna"
  [grok]="x-ai/grok-4.7"
  [gemini]="google/gemini-4-neon"
  [gemini-flash]="google/gemini-3.8-flash"
  [deepseek]="deepseek/deepseek-v4.1-flash-1017@inference-net/us"  # stepfun intermittently 400s "The input you provided is invalid"
  [qwen]="qwen/qwen4-max"
  [kimi]="moonshotai/kimi-k3.1-pro"
  [glm]="z-ai/glm-5.3-flash"
  [claude]="anthropic/claude-sonnet-5.5"
  # `chatgpt:` = ChatGPT subscription via the local proxy, not OpenRouter. Slugs
  # come from ~/.codex/models_cache.json. gpt-6-astra answered "no healthy
  # upstream" when tested on 2026-11-21, so the alias uses gpt-6-sol.
  [chatgpt]="chatgpt:gpt-6-sol"
  [chatgpt-mini]="chatgpt:gpt-6-luna"
)
ORDER=(gpt gpt-mini grok gemini gemini-flash deepseek qwen kimi glm claude chatgpt chatgpt-mini)

list() {
  printf '%-14s %s\n' ALIAS MODEL
  for k in "${ORDER[@]}"; do printf '%-14s %s\n' "$k" "${MODELS[$k]}"; done
}

# ---- load .env ----
if [[ -f "$DIR/.env" ]]; then
  set -a; . "$DIR/.env"; set +a
fi

# ---- pick model ----
choice="${1:-}"
if [[ "$choice" == "--list" || "$choice" == "-l" ]]; then list; exit 0; fi

if [[ -z "$choice" ]]; then
  echo "Select a model:"
  i=1
  for k in "${ORDER[@]}"; do printf '  %2d) %-14s %s\n' "$i" "$k" "${MODELS[$k]}"; i=$((i+1)); done
  read -rp "Number, alias, or OpenRouter model ID: " choice
  if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#ORDER[@]} )); then
    choice="${ORDER[choice-1]}"
  fi
else
  shift
fi

# ---- optional @provider pin (e.g. deepseek@deepinfra) ----
# A pin typed on the command line overrides the one baked into the alias.
PROVIDER=""
if [[ "$choice" == *@* ]]; then
  PROVIDER="${choice##*@}"
  choice="${choice%@*}"
fi

MODEL="${MODELS[$choice]:-$choice}"
if [[ "$MODEL" == *@* ]]; then
  : "${PROVIDER:=${MODEL##*@}}"
  MODEL="${MODEL%@*}"
fi

BACKEND=openrouter
if [[ "$MODEL" == chatgpt:?* ]]; then
  BACKEND=chatgpt
  if [[ -n "$PROVIDER" ]]; then
    echo "@provider pins are OpenRouter-only; '$choice' runs on your ChatGPT subscription" >&2; exit 1
  fi
elif [[ "$MODEL" != */* ]]; then
  echo "Unknown alias '$choice'. Run: $0 --list" >&2; exit 1
fi
if [[ "$BACKEND" == openrouter ]]; then
  : "${OPENROUTER_API_KEY:?OPENROUTER_API_KEY missing (put it in $DIR/.env)}"
fi

# ---- permission mode ----
# Auto mode is the default (see AUTO MODE below for why Claude Code's stock auto
# mode does nothing here). `--no-auto` restores the old behaviour of bypassing
# every permission prompt; so does an explicit --dangerously-skip-permissions or
# any other explicit --permission-mode.
AUTO_MODE=1
AUTO_FLAG=0     # whether --permission-mode auto is already in $@
FORCE_SKIP=0    # --no-auto: old behaviour, bypass every prompt
ARGS=()
while (( $# )); do
  case "$1" in
    --auto) AUTO_MODE=1; shift ;;
    --no-auto) AUTO_MODE=0; FORCE_SKIP=1; shift ;;
    --dangerously-skip-permissions) AUTO_MODE=0; ARGS+=("$1"); shift ;;
    --permission-mode=auto) AUTO_MODE=1; AUTO_FLAG=1; ARGS+=("$1"); shift ;;
    --permission-mode=*) AUTO_MODE=0; ARGS+=("$1"); shift ;;
    --permission-mode)
      ARGS+=("$1"); shift
      if (( $# )); then
        if [[ "$1" == "auto" ]]; then AUTO_MODE=1; AUTO_FLAG=1; else AUTO_MODE=0; fi
        ARGS+=("$1"); shift
      fi ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

# ---- reasoning effort (per alias) ----
# OpenRouter exposes one cross-model knob, `reasoning.effort` (`reasoning.max_tokens`
# is the token-budget alternative; per-model thinking budgets differ too much to pin
# here). "max" spends ~95% of the output cap. Key on the alias, or on a provider
# prefix a model ID starts with (so a bare `deepseek/...` ID gets it too).
declare -A EFFORT=(
  [deepseek]="max"
)
effort="${EFFORT[$choice]:-}"
if [[ -z "$effort" ]]; then
  for k in "${!EFFORT[@]}"; do
    [[ "$MODEL" == "$k"/* ]] && effort="${EFFORT[$k]}" && break
  done
fi

# ---- context window (per alias) ----
# Claude Code only knows Claude models' windows. For anything else it warns
# 'Model "..." isn't recognized · context assumed to be 1m tokens' and
# auto-compacts against that guess. CLAUDE_CODE_MAX_CONTEXT_TOKENS gives it the
# real window and silences the warning. Values are OpenRouter's context_length
# for the alias's routing (the pinned provider's when the alias has a pin, since
# providers can serve a smaller window than the model's max). A pin typed on the
# command line, or a model ID not listed here, is looked up live from
# OpenRouter. An explicit CLAUDE_CODE_MAX_CONTEXT_TOKENS in the environment wins.
declare -A CONTEXT=(
  [gpt]=1050000
  [gpt-mini]=1050000
  [grok]=500000
  [gemini]=1048576
  [gemini-flash]=1048576
  [deepseek]=1040000     # inference-net/us serves 1,040,000 (model max is 1,048,576)
  [qwen]=1000000
  [kimi]=1048576
  [glm]=262000           # tenstorrent/fp8; most providers serve 262,144
  [claude]=1000000
  [chatgpt]=272000       # context_window in ~/.codex/models_cache.json
  [chatgpt-mini]=272000
)
# ---- output token cap (per alias) ----
# Since 2.1.329 Claude Code no longer retries at the limit a `max_tokens` error
# names, so a provider that takes fewer output tokens than Claude Code asks for
# (32k by default) fails the request. CLAUDE_CODE_MAX_OUTPUT_TOKENS is exported
# only when the cap is under OUTPUT_FLOOR: setting a big cap would make Claude
# Code ask for it, and OpenRouter reserves credit for the full max_tokens.
# Values: smallest max_completion_tokens across the alias's routing (only the
# ones under the floor need listing; anything else is looked up live with the
# context window). An explicit CLAUDE_CODE_MAX_OUTPUT_TOKENS wins.
OUTPUT_FLOOR=32000
declare -A MAXOUT=(
  # none of the current aliases: every provider they route to takes >= 65,536
)
OUT="${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-}"
OUT_SET=0; [[ -n "$OUT" ]] && OUT_SET=1

CTX="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-}"
ALIAS_PIN=""
[[ "${MODELS[$choice]:-}" == *@* ]] && ALIAS_PIN="${MODELS[$choice]##*@}"
if [[ -n "${CONTEXT[$choice]:-}" && "$PROVIDER" == "$ALIAS_PIN" ]]; then
  [[ -z "$CTX" ]] && CTX="${CONTEXT[$choice]}"
  [[ -z "$OUT" ]] && OUT="${MAXOUT[$choice]:-}"
elif [[ "$BACKEND" == chatgpt ]]; then
  # The Codex backend takes no output cap (the proxy drops max_tokens), so only
  # the window matters; Codex caches it per model, no network needed.
  if [[ -z "$CTX" ]]; then
    CTX="$(python3 -I -c '
import json, os, sys
home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
try:
    models = json.load(open(os.path.join(home, "models_cache.json")))["models"]
except Exception:
    raise SystemExit
print(next((m["context_window"] for m in models
            if m.get("slug") == sys.argv[1] and m.get("context_window")), ""))' "${MODEL#chatgpt:}" 2>/dev/null || true)"
    [[ -z "$CTX" ]] && echo "→ note: ${MODEL#chatgpt:} not in Codex's model cache; Claude Code will assume a context window" >&2
  fi
elif [[ -z "$CTX" || -z "$OUT" ]]; then
  {
    # Pinned: that provider's limits. Unpinned: the smallest any provider serves,
    # since OpenRouter may route to any of them. Prints "<context> <output>".
    read -r LIVE_CTX LIVE_OUT < <(python3 -I -c '
import json, sys, urllib.request
model, pin, key = sys.argv[1:4]
req = urllib.request.Request(
    "https://openrouter.ai/api/v1/models/" + model + "/endpoints",
    headers={"Authorization": "Bearer " + key})
try:
    with urllib.request.urlopen(req, timeout=3) as r:
        eps = json.load(r)["data"]["endpoints"]
except Exception:
    raise SystemExit
if pin:
    # "z-ai" pins every z-ai/* endpoint variant, as OpenRouter matches it.
    eps = [e for e in eps if pin in (e.get("tag"), e.get("provider_name"))
           or (e.get("tag") or "").startswith(pin + "/")]
ctx = [e["context_length"] for e in eps if e.get("context_length")]
out = [e["max_completion_tokens"] for e in eps if e.get("max_completion_tokens")]
print(min(ctx) if ctx else "-", min(out) if out else "-")' "$MODEL" "$PROVIDER" "$OPENROUTER_API_KEY" 2>/dev/null || true) || true
    [[ -z "$CTX" && "${LIVE_CTX:--}" != "-" ]] && CTX="$LIVE_CTX"
    [[ -z "$OUT" && "${LIVE_OUT:--}" != "-" ]] && OUT="$LIVE_OUT"
    [[ -z "$CTX" ]] && echo "→ note: couldn't look up the context window for $MODEL; Claude Code will assume one" >&2
  }
fi
[[ -n "$CTX" ]] && export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$CTX"
if (( OUT_SET )); then
  :   # user's value, already in the environment
elif [[ "$OUT" =~ ^[0-9]+$ ]] && (( OUT < OUTPUT_FLOOR )); then
  export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$OUT"
else
  OUT=""
fi

# ---- point Claude Code at OpenRouter's Anthropic-compatible endpoint ----
# (ChatGPT mode sets the base URL and token once its proxy is up, just before
# launch; the bare slug is the model name Claude Code shows.)
MODEL_ID="${MODEL#chatgpt:}"
if [[ "$BACKEND" == openrouter ]]; then
  export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
  export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
fi
export ANTHROPIC_API_KEY=""   # must be explicitly empty so it isn't used
export ANTHROPIC_MODEL="$MODEL_ID"
export ANTHROPIC_SMALL_FAST_MODEL="$MODEL_ID"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL_ID"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL_ID"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL_ID"
export CLAUDE_CODE_SUBAGENT_MODEL="$MODEL_ID"

# ---- keep Claude Code quiet without switching off terminal titles ----
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC puts Claude Code in "essential
# traffic only" mode, and that one flag also disables non-traffic features:
# the session title that names the terminal tab/window is gated on it, so the
# title stayed a bare "Claude Code" and /resume rows lost their AI names.
# Nothing else can switch the title feature back on, so disable the individual
# pieces of nonessential traffic instead. (A parent Claude Code session can leak
# the old variable into this process, so drop it explicitly.)
unset CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
export DISABLE_BUG_COMMAND=1
export DISABLE_FEEDBACK_COMMAND=1
export DISABLE_AUTOUPDATER=1
export CLAUDE_CODE_DISABLE_FEATURE_FLAGS=1
# claude.ai connectors only load under a claude.ai login, which ANTHROPIC_AUTH_TOKEN
# outranks, so each launch printed "⚠ claude.ai connectors are disabled because
# ANTHROPIC_API_KEY or another auth source is set ..." (2.1.329). Turning the
# loading off loses nothing here and drops the warning.
export ENABLE_CLAUDEAI_MCP_SERVERS="${ENABLE_CLAUDEAI_MCP_SERVERS:-false}"

# ---- prompt suggestions (the greyed next-prompt ghost text) ----
# Off by default here: the feature is gated on a GrowthBook flag that a
# first-party sign-in populates, and the flag lookup never happens against
# OpenRouter, so it silently reads as false. CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION
# short-circuits that gate. Claude Code generates each suggestion with the
# session's own model and reuses its prompt cache (an Anthropic request costs
# ~300 input tokens plus cache reads), so this is cheap; it is not routed to
# ANTHROPIC_SMALL_FAST_MODEL. Set the variable to 0 to turn them off again.
# Caveat: Claude Code suppresses suggestions once the previous reply used more
# than 10k uncached tokens. Providers that report no prompt-cache hits (Gemini,
# some others) hit that ceiling every turn, because the system prompt and tool
# definitions alone exceed it, so suggestions stay absent for those models.
if [[ -z "${CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION:-}" ]]; then
  export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=1
fi

# ---- restore the skill parity Anthropic models get for free ----
# With a first-party model, Claude Code also loads the account skills synced to
# ~/.claude/skills/synced (pdf, docx, xlsx, pptx, skill-creator, deep-research, ...).
# That sync is gated on `ke()==="firstParty"`, so a custom base URL silently drops
# them — they sit on disk, loaded by nothing. Re-expose the ones that work without
# Anthropic services as a normal local plugin, which loads under any model. Build it
# on first run and rebuild whenever the sync writes a new manifest, so updates to
# the skills flow through on their own.
# (/schedule, /usage-credits, /insights etc. are account-entitlement upsells and
# cannot be restored this way — don't expect them here.)
SKILLS_PLUGIN="$DIR/.skills-plugin"
# The sync root holds one bucket directory; dot-files (lock/marker) sit beside it.
SYNC_DIR="$(find "$HOME/.claude/skills/synced" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1)"
SYNC_STAMP="$(md5sum "$SYNC_DIR/manifest.json" 2>/dev/null | cut -d' ' -f1)"

# Skills worth carrying over: the ones whose work is done in files. Left out on
# purpose: browser/computer-use (need tools this session doesn't have) and
# docs/morning/import-memory (claude.ai connectors + memory, not third-party paths).
SKILLS_KEEP=(pdf docx pptx xlsx skill-creator deep-research)

build_skills_plugin() {
  local d="$1"
  rm -rf "$d"; mkdir -p "$d/.claude-plugin" "$d/skills"
  printf '%s\n' \
    '{"name":"claude-or-skills","version":"1.0.0",' \
    ' "description":"Account skills (pdf, docx, office, research) re-exposed for third-party models"}' \
    > "$d/.claude-plugin/plugin.json"
  local s
  for s in "${SKILLS_KEEP[@]}"; do
    if [[ -f "$SYNC_DIR/$s/SKILL.md" ]]; then ln -s "$SYNC_DIR/$s" "$d/skills/$s"; fi
  done
  printf '%s\n' "${SYNC_STAMP:-none}" > "$d/.stamp"
}

if [[ -n "$SYNC_DIR" && -n "$SYNC_STAMP" ]]; then
  if [[ ! -f "$SKILLS_PLUGIN/.stamp" || "$(cat "$SKILLS_PLUGIN/.stamp" 2>/dev/null)" != "$SYNC_STAMP" ]]; then
    build_skills_plugin "$SKILLS_PLUGIN"
  fi
  # Same idea for the account plugins Claude Code syncs from claude.ai.
  SYNCED_PLUGINS="$(find "$HOME/.claude/plugins/synced" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1)"
  PLUGIN_ARGS=(--plugin-dir "$SKILLS_PLUGIN")
  [[ -n "$SYNCED_PLUGINS" ]] && PLUGIN_ARGS+=(--plugin-dir "$SYNCED_PLUGINS")
else
  PLUGIN_ARGS=()
fi

# ---- auto mode's classifier ----
# In stock Claude Code, auto mode's safety check is server-side: each request
# carries a `safeguards` field and the dangerous-tool-use beta, and Anthropic's
# API answers with a verdict per tool call. OpenRouter's Anthropic-compatible
# endpoint accepts the request but never returns a verdict, and Claude Code
# treats "no verdict" as "nothing was flagged" — so auto mode silently approves
# everything instead of checking it. CLAUDE_CODE_AUTO_MODE_SERVER=0 turns off
# the server check, which makes Claude Code run its own classifier instead:
# an ordinary model call, which a fast OpenRouter model can serve.
# The classifier is anthropic/claude-haiku-5.5. Its provider is left to
# OpenRouter (no preference is sent); set CLAUDE_OR_CLASSIFIER_PROVIDER to
# force one.
# In ChatGPT mode every request goes to the proxy, so the classifier must be a
# ChatGPT model too: gpt-6-luna by default, and CLAUDE_OR_CLASSIFIER_MODEL takes
# a bare or `chatgpt:` slug (an OpenRouter ID there is an error).
if [[ "$BACKEND" == chatgpt ]]; then
  CLASSIFIER_MODEL="${CLAUDE_OR_CLASSIFIER_MODEL:-gpt-6-luna}"
  CLASSIFIER_MODEL="${CLASSIFIER_MODEL#chatgpt:}"
  if [[ "$CLASSIFIER_MODEL" == */* ]]; then
    echo "CLAUDE_OR_CLASSIFIER_MODEL=$CLASSIFIER_MODEL is an OpenRouter ID; ChatGPT mode needs a ChatGPT slug (e.g. gpt-6-luna)" >&2; exit 1
  fi
  CLASSIFIER_PROVIDER=""   # no pins here, so the reconciliation below is a no-op
else
  CLASSIFIER_MODEL="${CLAUDE_OR_CLASSIFIER_MODEL:-anthropic/claude-haiku-5.5}"
  CLASSIFIER_PROVIDER="${CLAUDE_OR_CLASSIFIER_PROVIDER:-}"
fi
export CLAUDE_CODE_AUTO_MODE_SERVER=0
export CLAUDE_CODE_AUTO_MODE_MODEL="$CLASSIFIER_MODEL"

# A provider pin is request-body state, so it lands on the classifier request
# too, and OpenRouter then refuses that one: "no allowed providers" for a
# provider that doesn't serve the classifier model. Dropping the pin fixes that
# but lets OpenRouter reroute the main model. Instead, add the classifier's
# provider to the allow-list: `only` is filtered per model, so each model keeps
# its own provider. Without a pin (nothing to filter against), ask for the
# classifier's provider with `order` and leave fallbacks on, which only affects
# models that provider actually serves. When the classifier is the main model
# itself, one pin already covers both.
PIN_EXTRA=""
ORDER_PROVIDER=""
if (( AUTO_MODE )); then
  if [[ "$CLASSIFIER_MODEL" == "$MODEL" ]]; then
    # Same model on both sides: a pin serves both, or pin both to the usual one.
    if [[ -z "$PROVIDER" && -n "$CLASSIFIER_PROVIDER" ]]; then
      PROVIDER="$CLASSIFIER_PROVIDER"
      echo "→ auto mode: classifier is the model itself; pinning both to '$PROVIDER'" >&2
    fi
  elif [[ -n "$PROVIDER" ]]; then
    PIN_EXTRA="$(python3 -I -c '
import json, sys, urllib.request
main_model, cls_model, pin, pref, key = sys.argv[1:6]
def endpoints(model):
    req = urllib.request.Request(
        "https://openrouter.ai/api/v1/models/" + model + "/endpoints",
        headers={"Authorization": "Bearer " + key})
    with urllib.request.urlopen(req, timeout=3) as r:
        return json.load(r)["data"]["endpoints"]
# As OpenRouter matches `only`: a slug selects its exact tag, every variant
# under it ("z-ai" selects "z-ai/fp4"), or the display name.
def matches(slug, e):
    tag = e.get("tag") or ""
    return slug in (tag, e.get("provider_name")) or tag.startswith(slug + "/")
def serves(slug, eps):
    return any(matches(slug, e) for e in eps)
try:
    main, cls = endpoints(main_model), endpoints(cls_model)
except Exception:
    raise SystemExit
if pin and serves(pin, cls):
    print(pin); raise SystemExit            # the pin already serves the classifier
if pref and not serves(pref, cls):
    pref = ""                               # preferred provider cannot serve it
if pref and not serves(pref, main):
    print(pref); raise SystemExit
# A second allow-list entry must not also select a main-model endpoint, or the
# main model could reroute there.
cands = [(e.get("tag") or e.get("provider_name") or "", e.get("provider_name") or "")
         for e in cls]
cands = [c for c in cands if c[0] and not serves(c[0], main)]
if cls_model.startswith("anthropic/"):
    cands.sort(key=lambda c: 0 if c[1] == "Anthropic" else 1)
if cands:
    print(cands[0][0])' "$MODEL" "$CLASSIFIER_MODEL" "$PROVIDER" "$CLASSIFIER_PROVIDER" "$OPENROUTER_API_KEY" 2>/dev/null || true)"
    if [[ -n "$PIN_EXTRA" && "$PIN_EXTRA" != "$PROVIDER" ]]; then
      echo "→ auto mode: pin '$PROVIDER' kept; classifier routes to '$PIN_EXTRA'" >&2
    elif [[ -z "$PIN_EXTRA" ]]; then
      echo "→ auto mode: no provider found for the classifier; dropping pin '$PROVIDER' (main model may reroute)" >&2
      PROVIDER=""
    fi
  elif [[ -z "$PROVIDER" && -n "$CLASSIFIER_PROVIDER" ]]; then
    ORDER_PROVIDER="$CLASSIFIER_PROVIDER"
    echo "→ auto mode: classifier prefers '$ORDER_PROVIDER'; main model keeps OpenRouter's routing" >&2
  fi
elif [[ -n "$PROVIDER" && "$CLASSIFIER_MODEL" != "$MODEL" ]]; then
  echo "→ note: provider pin set, so shift+tab auto mode has no classifier; rerun with --auto" >&2
fi


if [[ -z "$PROVIDER" && -n "${CLAUDE_CODE_EXTRA_BODY:-}" ]]; then
  CLAUDE_CODE_EXTRA_BODY="$(python3 -I -c '
import json, sys
try:
    body = json.loads(sys.argv[1])
except ValueError:
    print(sys.argv[1]); raise SystemExit
if isinstance(body, dict) and body.pop("provider", None) is not None:
    print(json.dumps(body))
else:
    print(sys.argv[1])' "$CLAUDE_CODE_EXTRA_BODY")"
  [[ "$CLAUDE_CODE_EXTRA_BODY" == "{}" ]] && unset CLAUDE_CODE_EXTRA_BODY
  export CLAUDE_CODE_EXTRA_BODY
fi

# OpenRouter's Anthropic endpoint has no header/query way to choose a provider, so
# merge provider preferences into the request body. Respect an EXTRA_BODY the user
# already set by splicing both objects together instead of overwriting.
if [[ -n "$PROVIDER" ]]; then
  ONLY_JSON="\"$PROVIDER\""
  # Second entry, if any, only ever matches the classifier model (see above).
  [[ -n "$PIN_EXTRA" && "$PIN_EXTRA" != "$PROVIDER" ]] && ONLY_JSON="$ONLY_JSON,\"$PIN_EXTRA\""
  PREFS="{\"only\":[$ONLY_JSON],\"allow_fallbacks\":false}"
elif [[ -n "$ORDER_PROVIDER" ]]; then
  PREFS="{\"order\":[\"$ORDER_PROVIDER\"],\"allow_fallbacks\":true}"
fi
if [[ -n "$PROVIDER" || -n "$ORDER_PROVIDER" ]]; then
  if [[ -n "${CLAUDE_CODE_EXTRA_BODY:-}" ]]; then
    export CLAUDE_CODE_EXTRA_BODY="$(python3 -I -c '
import json, sys
base, prefs = json.loads(sys.argv[1]), json.loads(sys.argv[2])
base["provider"] = {**base.get("provider", {}), **prefs}
print(json.dumps(base))' "$CLAUDE_CODE_EXTRA_BODY" "$PREFS")"
  else
    export CLAUDE_CODE_EXTRA_BODY="{\"provider\":$PREFS}"
  fi
fi

# Merge reasoning effort in, keeping whatever body the user or the pin built.
if [[ -n "$effort" ]]; then
  if [[ -n "${CLAUDE_CODE_EXTRA_BODY:-}" ]]; then
    export CLAUDE_CODE_EXTRA_BODY="$(python3 -I -c '
import json, sys
base, effort = json.loads(sys.argv[1]), sys.argv[2]
base["reasoning"] = {**base.get("reasoning", {}), "effort": effort}
print(json.dumps(base))' "$CLAUDE_CODE_EXTRA_BODY" "$effort")"
  else
    export CLAUDE_CODE_EXTRA_BODY="$(printf '{"reasoning":{"effort":"%s"}}' "$effort")"
  fi
fi

# ---- appended system prompt ----
# A house instruction added to the end of Claude Code's own system prompt, on
# every run. First match wins:
#   CLAUDE_OR_SYSTEM_PROMPT       literal text to append
#   CLAUDE_OR_SYSTEM_PROMPT_FILE  path to a file whose text is appended
#   system-prompt.md              file next to this script (default)
# CLAUDE_OR_SYSTEM_PROMPT=0 turns it off (also: false/off). Explicit
# --system-prompt[-file] or --append-system-prompt[-file] args always win and
# suppress this, so callers can still override the prompt per run.
PROMPT_TEXT=""
PROMPT_SKIP=0
for a in ${ARGS[@]+"${ARGS[@]}"}; do
  case "$a" in
    --system-prompt|--system-prompt-file|--append-system-prompt|--append-system-prompt-file|--system-prompt=*|--append-system-prompt=*)
      PROMPT_SKIP=1 ;;
  esac
done
if (( ! PROMPT_SKIP )); then
  case "${CLAUDE_OR_SYSTEM_PROMPT:-}" in
    0|false|off) ;;
    "")
      if [[ -n "${CLAUDE_OR_SYSTEM_PROMPT_FILE:-}" ]]; then
        if [[ ! -f "$CLAUDE_OR_SYSTEM_PROMPT_FILE" ]]; then
          echo "CLAUDE_OR_SYSTEM_PROMPT_FILE not found: $CLAUDE_OR_SYSTEM_PROMPT_FILE" >&2; exit 1
        fi
        PROMPT_TEXT="$(cat "$CLAUDE_OR_SYSTEM_PROMPT_FILE")"
      elif [[ -f "$DIR/system-prompt.md" ]]; then
        PROMPT_TEXT="$(cat "$DIR/system-prompt.md")"
      fi ;;
    *) PROMPT_TEXT="$CLAUDE_OR_SYSTEM_PROMPT" ;;
  esac
fi
[[ -n "$PROMPT_TEXT" ]] && set -- --append-system-prompt "$PROMPT_TEXT" "$@"

# ---- ChatGPT subscription (local proxy) ----
# Claude Code only speaks Anthropic Messages; a ChatGPT plan is only reachable
# through the Codex backend (chatgpt.com/backend-api/codex/responses), which
# speaks the OpenAI Responses API with the Codex CLI's OAuth tokens. So ChatGPT
# mode starts the stdlib proxy below on a random 127.0.0.1 port and points
# ANTHROPIC_BASE_URL at it. Notes (Codex CLI 0.155, tested 2026-11-21):
#   - Auth is shared with Codex. Refresh tokens rotate on use, so the proxy
#     writes refreshed tokens back to auth.json (atomic replace); keeping its own
#     copy would log Codex out on its next refresh.
#   - The backend rejects max_tokens/temperature, wants store=false and a stream,
#     and accepts our own `instructions` (Claude Code's system prompt).
#   - GPT reasoning survives across turns: the encrypted reasoning item rides in
#     the thinking block's signature (prefix "cor1:"), which Claude Code sends back.
#   - Anthropic server tools (WebSearch's web_search_*) have no mapping and are
#     dropped; count_tokens is a bytes/4 estimate.
# The proxy accepts only a per-run random token (ANTHROPIC_AUTH_TOKEN) and exits
# within 2s of this PID going away; exec keeps the PID, so that is Claude Code's.
chatgpt_proxy_py() {
  cat <<'PY'
import base64, fcntl, http.server, json, os, sys, threading, time, urllib.error, urllib.request, uuid

UPSTREAM = "https://chatgpt.com/backend-api/codex/responses"
USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"   # what Codex's /status reads
TOKEN_URL = "https://auth.openai.com/oauth/token"
CLIENT_ID = "app_EMoamEEZ73f0CkXaXp7hrann"   # Codex CLI's OAuth client
AUTH_FILE = os.path.join(os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), "auth.json")
SECRET = os.environ.pop("CLAUDE_OR_PROXY_SECRET", "")
PARENT = int(sys.argv[1]) if len(sys.argv) > 1 else 0
DEBUG = os.environ.get("CLAUDE_OR_PROXY_LOG", "")
SIG_PREFIX = "cor1:"   # thinking-block signature carrying the Responses reasoning item
lock = threading.Lock()


def log(*a):
    if DEBUG:
        with open(DEBUG, "a") as f:
            print(time.strftime("%H:%M:%S"), *a, file=f)


# ---------- auth (shared with Codex: refresh tokens rotate, so write back) ----------
def jwt_exp(tok):
    try:
        p = tok.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(p + "=" * (-len(p) % 4))).get("exp", 0)
    except Exception:
        return 0


def read_auth():
    with open(AUTH_FILE) as f:
        return json.load(f)


def refresh(stale_access):
    with lock, open(AUTH_FILE + ".claude-or.lock", "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        auth = read_auth()
        tok = auth.get("tokens") or {}
        if tok.get("access_token") != stale_access and jwt_exp(tok.get("access_token", "")) > time.time() + 60:
            return auth   # someone (Codex, another claude-or) already refreshed
        body = json.dumps({"client_id": CLIENT_ID, "grant_type": "refresh_token",
                           "refresh_token": tok.get("refresh_token", ""),
                           "scope": "openid profile email"}).encode()
        req = urllib.request.Request(TOKEN_URL, body, {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=30) as r:
            new = json.load(r)
        for k in ("id_token", "access_token", "refresh_token"):
            if new.get(k):
                tok[k] = new[k]
        auth["tokens"] = tok
        auth["last_refresh"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        tmp = AUTH_FILE + ".claude-or.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(auth, f, indent=2)
        os.replace(tmp, AUTH_FILE)
        log("refreshed token")
        return auth


def credentials(force=False):
    auth = read_auth()
    tok = auth.get("tokens") or {}
    if force or jwt_exp(tok.get("access_token", "")) < time.time() + 60:
        auth = refresh(tok.get("access_token"))
        tok = auth["tokens"]
    return tok["access_token"], tok.get("account_id", "")


# ---------- Anthropic Messages -> Responses ----------
def text_of(content):
    if isinstance(content, str):
        return content
    return "\n".join(b.get("text", "") for b in content or [] if b.get("type") == "text")


def image_part(b):
    src = b.get("source") or {}
    if src.get("type") == "base64":
        return {"type": "input_image", "image_url": "data:%s;base64,%s" % (src.get("media_type"), src.get("data"))}
    if src.get("type") == "url":
        return {"type": "input_image", "image_url": src.get("url")}
    return None


def convert_input(messages):
    items = []
    for m in messages:
        role, content = m.get("role"), m.get("content")
        if role == "system":
            role = "developer"   # mid-conversation system turns (CC 2.1.329); the backend refuses "system"
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        parts = []

        def flush():
            if parts:
                items.append({"type": "message", "role": role, "content": list(parts)})
                parts.clear()

        for b in content or []:
            t = b.get("type")
            if t == "text":
                if b.get("text"):
                    parts.append({"type": "output_text" if role == "assistant" else "input_text", "text": b["text"]})
            elif t == "image" and role == "user":
                p = image_part(b)
                if p:
                    parts.append(p)
            elif t == "tool_result":
                flush()
                c = b.get("content")
                out = c if isinstance(c, str) else text_of(c)
                if b.get("is_error"):
                    out = "[tool error] " + out
                items.append({"type": "function_call_output", "call_id": b.get("tool_use_id"), "output": out or ""})
                imgs = [image_part(x) for x in (c if isinstance(c, list) else []) if x.get("type") == "image"]
                imgs = [i for i in imgs if i]
                if imgs:
                    items.append({"type": "message", "role": "user", "content": imgs})
            elif t == "tool_use":
                flush()
                items.append({"type": "function_call", "call_id": b.get("id"), "name": b.get("name"),
                              "arguments": json.dumps(b.get("input") or {})})
            elif t == "thinking" and role == "assistant":
                sig = b.get("signature") or ""
                if sig.startswith(SIG_PREFIX):
                    flush()
                    try:
                        enc = base64.b64decode(sig[len(SIG_PREFIX):]).decode()
                    except Exception:
                        continue
                    summary = [{"type": "summary_text", "text": b["thinking"]}] if b.get("thinking") else []
                    items.append({"type": "reasoning", "summary": summary, "encrypted_content": enc})
        flush()
    return items


def convert_tools(tools):
    out = []
    for t in tools or []:
        if t.get("type") not in (None, "custom"):
            continue   # Anthropic server tools (web_search_*, ...) have no equivalent here
        out.append({"type": "function", "name": t["name"], "description": t.get("description", ""),
                    "parameters": t.get("input_schema") or {"type": "object", "properties": {}}, "strict": False})
    return out


def convert_tool_choice(tc):
    if not tc:
        return "auto"
    return {"auto": "auto", "any": "required", "none": "none"}.get(tc.get("type")) or \
        {"type": "function", "name": tc.get("name")}


def build_request(body):
    model = body.get("model", "")
    model = model.split(":", 1)[1] if model.startswith("chatgpt:") else model
    # reasoning.effort is what claude-or puts in CLAUDE_CODE_EXTRA_BODY; output_config
    # is Claude Code's own effort field. Neither set: the model's default.
    effort = (body.get("reasoning") or {}).get("effort") or (body.get("output_config") or {}).get("effort")
    sysp = body.get("system")
    req = {
        "model": model,
        "instructions": text_of(sysp) if sysp else "",
        "input": convert_input(body.get("messages") or []),
        "tools": convert_tools(body.get("tools")),
        "tool_choice": convert_tool_choice(body.get("tool_choice")),
        "parallel_tool_calls": not (body.get("tool_choice") or {}).get("disable_parallel_tool_use"),
        "store": False,
        "stream": True,
        "include": ["reasoning.encrypted_content"],
        "reasoning": {"summary": "auto", **({"effort": effort} if effort else {})},
    }
    uid = (body.get("metadata") or {}).get("user_id")
    if uid:
        req["prompt_cache_key"] = str(uuid.uuid5(uuid.NAMESPACE_URL, uid))
    return req


# ---------- Responses SSE -> Anthropic events ----------
def sse_events(resp):
    data = []
    for raw in resp:
        line = raw.decode("utf-8", "replace").rstrip("\r\n")
        if line.startswith("data:"):
            data.append(line[5:].lstrip())
        elif not line and data:
            try:
                yield json.loads("\n".join(data))
            except ValueError:
                pass
            data = []


def translate(resp, model):
    msg_id = "msg_" + uuid.uuid4().hex[:24]
    yield "message_start", {"type": "message_start", "message": {
        "id": msg_id, "type": "message", "role": "assistant", "model": model, "content": [],
        "stop_reason": None, "stop_sequence": None, "usage": {"input_tokens": 0, "output_tokens": 0}}}
    idx = -1
    open_kind = None   # (output_index, kind)
    got_args = False
    saw_tool = False

    def close():
        nonlocal open_kind
        if open_kind:
            open_kind = None
            return [("content_block_stop", {"type": "content_block_stop", "index": idx})]
        return []

    for ev in sse_events(resp):
        t = ev.get("type", "")
        if t == "response.output_item.added":
            item = ev.get("item") or {}
            it = item.get("type")
            for e in close():
                yield e
            if it == "reasoning":
                idx += 1; open_kind = "thinking"
                yield "content_block_start", {"type": "content_block_start", "index": idx,
                                              "content_block": {"type": "thinking", "thinking": "", "signature": ""}}
            elif it == "message":
                idx += 1; open_kind = "text"
                yield "content_block_start", {"type": "content_block_start", "index": idx,
                                              "content_block": {"type": "text", "text": ""}}
            elif it == "function_call":
                idx += 1; open_kind = "tool"; got_args = False; saw_tool = True
                yield "content_block_start", {"type": "content_block_start", "index": idx, "content_block": {
                    "type": "tool_use", "id": item.get("call_id"), "name": item.get("name"), "input": {}}}
        elif t == "response.output_text.delta" and open_kind == "text":
            yield "content_block_delta", {"type": "content_block_delta", "index": idx,
                                          "delta": {"type": "text_delta", "text": ev.get("delta", "")}}
        elif t == "response.reasoning_summary_text.delta" and open_kind == "thinking":
            yield "content_block_delta", {"type": "content_block_delta", "index": idx,
                                          "delta": {"type": "thinking_delta", "thinking": ev.get("delta", "")}}
        elif t == "response.reasoning_summary_part.added" and open_kind == "thinking" and ev.get("summary_index"):
            yield "content_block_delta", {"type": "content_block_delta", "index": idx,
                                          "delta": {"type": "thinking_delta", "thinking": "\n\n"}}
        elif t == "response.function_call_arguments.delta" and open_kind == "tool":
            got_args = True
            yield "content_block_delta", {"type": "content_block_delta", "index": idx,
                                          "delta": {"type": "input_json_delta", "partial_json": ev.get("delta", "")}}
        elif t == "response.output_item.done":
            item = ev.get("item") or {}
            if open_kind == "thinking" and item.get("type") == "reasoning":
                sig = SIG_PREFIX + base64.b64encode((item.get("encrypted_content") or "").encode()).decode()
                yield "content_block_delta", {"type": "content_block_delta", "index": idx,
                                              "delta": {"type": "signature_delta", "signature": sig}}
            elif open_kind == "tool" and not got_args and item.get("arguments"):
                yield "content_block_delta", {"type": "content_block_delta", "index": idx,
                                              "delta": {"type": "input_json_delta", "partial_json": item["arguments"]}}
            for e in close():
                yield e
        elif t in ("response.completed", "response.incomplete"):
            for e in close():
                yield e
            r = ev.get("response") or {}
            u = r.get("usage") or {}
            cached = (u.get("input_tokens_details") or {}).get("cached_tokens", 0) or 0
            reason = "tool_use" if saw_tool else "end_turn"
            if t == "response.incomplete" and (r.get("incomplete_details") or {}).get("reason") == "max_output_tokens":
                reason = "max_tokens"
            yield "message_delta", {"type": "message_delta", "delta": {"stop_reason": reason, "stop_sequence": None},
                                    "usage": {"input_tokens": max(0, (u.get("input_tokens") or 0) - cached),
                                              "cache_read_input_tokens": cached,
                                              "output_tokens": u.get("output_tokens") or 0}}
            yield "message_stop", {"type": "message_stop"}
            return
        elif t in ("response.failed", "error"):
            err = (ev.get("response") or {}).get("error") or ev.get("error") or ev
            yield "error", {"type": "error", "error": {"type": "api_error", "message": err.get("message") or json.dumps(err)}}
            return
    yield "error", {"type": "error", "error": {"type": "api_error", "message": "ChatGPT stream ended early"}}


def collect(events):
    msg, blocks, partial = None, [], {}
    for name, ev in events:
        if name == "message_start":
            msg = ev["message"]
        elif name == "content_block_start":
            blocks.append(dict(ev["content_block"]))
        elif name == "content_block_delta":
            b, d = blocks[ev["index"]], ev["delta"]
            if d["type"] == "text_delta": b["text"] += d["text"]
            elif d["type"] == "thinking_delta": b["thinking"] += d["thinking"]
            elif d["type"] == "signature_delta": b["signature"] = d["signature"]
            elif d["type"] == "input_json_delta": partial[ev["index"]] = partial.get(ev["index"], "") + d["partial_json"]
        elif name == "message_delta":
            msg.update(ev["delta"]); msg["usage"] = ev["usage"]
        elif name == "error":
            return None, ev
    for i, s in partial.items():
        try:
            blocks[i]["input"] = json.loads(s) if s else {}
        except ValueError:
            blocks[i]["input"] = {}
    msg["content"] = blocks
    return msg, None


# ---------- HTTP ----------
ERR_TYPES = {400: "invalid_request_error", 401: "authentication_error", 403: "permission_error",
             404: "not_found_error", 429: "rate_limit_error", 529: "overloaded_error"}


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def send_json(self, status, obj):
        data = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def send_err(self, status, message):
        self.send_json(status, {"type": "error", "error": {"type": ERR_TYPES.get(status, "api_error"), "message": message}})

    def do_HEAD(self):
        self.send_response(200); self.send_header("Content-Length", "0"); self.end_headers()

    def authorised(self):
        return not SECRET or self.headers.get("x-api-key") == SECRET or \
            self.headers.get("Authorization") == "Bearer " + SECRET

    def do_GET(self):
        if self.path.split("?")[0] != "/claude-or/usage":
            return self.send_json(200, {"ok": True})
        # For the status line: it shares this process's token handling, so it never
        # refreshes (and rotates) the Codex login on its own.
        if not self.authorised():
            return self.send_err(401, "bad proxy token")
        for attempt in (0, 1):
            try:
                access, account = credentials(force=attempt == 1)
                req = urllib.request.Request(USAGE_URL, headers={
                    "Authorization": "Bearer " + access, "chatgpt-account-id": account,
                    "originator": "codex_cli_rs", "Accept": "application/json"})
                with urllib.request.urlopen(req, timeout=5) as r:
                    u = json.load(r)
                break
            except urllib.error.HTTPError as e:
                if e.code == 401 and attempt == 0:
                    continue
                return self.send_err(502, "usage: HTTP %d" % e.code)
            except Exception as e:
                return self.send_err(502, "usage: %s" % e)
        # Only what the status line shows; the payload also carries email/account ids.
        self.send_json(200, {k: u.get(k) for k in ("plan_type", "rate_limit", "credits", "rate_limit_reached_type")})

    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(n)
        if not self.authorised():
            return self.send_err(401, "bad proxy token")
        try:
            body = json.loads(raw or b"{}")
        except ValueError:
            return self.send_err(400, "invalid JSON")
        path = self.path.split("?")[0]
        if path.endswith("/count_tokens"):
            return self.send_json(200, {"input_tokens": len(raw) // 4})
        if not path.endswith("/v1/messages"):
            return self.send_err(404, "not found: " + path)
        req = build_request(body)
        log("->", req["model"], "effort", req["reasoning"].get("effort"), "items", len(req["input"]), "tools", len(req["tools"]))
        payload = json.dumps(req).encode()
        resp = None
        for attempt in (0, 1):
            try:
                access, account = credentials(force=attempt == 1)
            except Exception as e:
                return self.send_err(401, "ChatGPT login unusable (%s). Run `codex login` and retry." % e)
            headers = {"Authorization": "Bearer " + access, "chatgpt-account-id": account,
                       "OpenAI-Beta": "responses=experimental", "originator": "codex_cli_rs",
                       "Content-Type": "application/json", "Accept": "text/event-stream",
                       "session_id": req.get("prompt_cache_key") or str(uuid.uuid4())}
            try:
                resp = urllib.request.urlopen(urllib.request.Request(UPSTREAM, payload, headers), timeout=600)
                break
            except urllib.error.HTTPError as e:
                detail = e.read().decode("utf-8", "replace")[:2000]
                log("<- HTTP", e.code, detail)
                if e.code == 401 and attempt == 0:
                    continue
                try:
                    j = json.loads(detail)
                    msg = (j.get("error") or {}).get("message") or j.get("detail") or detail
                except ValueError:
                    msg = detail
                if not isinstance(msg, str):
                    msg = json.dumps(msg)
                # 5xx passes through so Claude Code's own retry kicks in.
                status = e.code if e.code in ERR_TYPES or 500 <= e.code < 600 else 502
                return self.send_err(status, "ChatGPT: " + msg)
            except Exception as e:
                return self.send_err(502, "ChatGPT unreachable: %s" % e)
        model = body.get("model", "")
        with resp:
            events = translate(resp, model)
            if not body.get("stream"):
                msg, err = collect(events)
                return self.send_json(200, msg) if msg else self.send_err(502, err["error"]["message"])
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "close")
            self.end_headers()
            self.close_connection = True
            try:
                for name, ev in events:
                    self.wfile.write(("event: %s\ndata: %s\n\n" % (name, json.dumps(ev))).encode())
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass


def watch_parent():
    while True:
        time.sleep(2)
        try:
            os.kill(PARENT, 0)
        except ProcessLookupError:
            os._exit(0)
        except PermissionError:
            pass


srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
srv.daemon_threads = True
if PARENT:
    threading.Thread(target=watch_parent, daemon=True).start()
print(srv.server_address[1], flush=True)
sys.stdout.close()
srv.serve_forever()
PY
}

